# Supply-chain age rule (owner, 2026-10-14): npm resolves only versions published at least 14 days ago.
# Needs npm >= 11.19 (npm 10 and older silently ignore it). `npm ci` installs the lockfile as-is, so the
# rule only matters when a lockfile is created or changed. A security fix younger than 14 days needs the
# owner's review first, then one `min-release-age-exclude[]=NAME` line here with the advisory id and date.
min-release-age=14
