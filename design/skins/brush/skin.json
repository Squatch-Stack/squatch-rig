  "id": "cc.squatch.skin.brush",
  "name": "Brush",
  "version": "0.1.0",
  "author": "Squatch Stack",
  "license": "CC-BY-4.0",
  "description": "The house look: a pedal drawn from above with the pen, legends in the hand, and brush marks only where there is signal.",
