{
 "name": "brush-ink",
 "note": "The default skin. Maps the design job's device SVGs (design/assets/devices, written by design/src/rigart.py) onto node types; colours come from web/css/app.css. {ways} picks the 2/3/4-path splitter and mixer art. ?skin=ink selects the older built-in line art. A device with a \"plate\" is drawn from the owner-approved pedal plate (assets/plates, web/js/ui/plates.js) by default; ?pedalart=0 draws its \"svg\" line art instead.",
 "devices": {
  "input": { "svg": "assets/devices/io-input.svg", "scale": 0.8 },
  "output": { "svg": "assets/devices/io-output.svg", "scale": 0.8, "plate": "assets/plates/output.svg", "name": "Output" },
  "gate": { "svg": "assets/devices/pedal-gate.svg", "scale": 0.8, "plate": "assets/plates/gate.svg", "lacquer": "gate", "name": "Squatch Gate" },
  "compressor": { "svg": "assets/devices/pedal-compressor.svg", "scale": 0.8, "plate": "assets/plates/comp.svg", "lacquer": "comp", "name": "Squatch Comp" },
  "overdrive": { "svg": "assets/devices/pedal-overdrive.svg", "scale": 0.8, "plate": "assets/plates/trail-od.svg", "lacquer": "od", "name": "Squatch Trail OD" },
  "bloom": { "svg": "assets/devices/pedal-bloom.svg", "scale": 0.8, "plate": "assets/plates/bloom.svg", "name": "Squatch Bloom",
   "face": {
    "glyph": { "ink": "bloomLeaf", "inkDim": "bloomDim", "paper": "bloom" },
    "knob": { "paper": "bloomLeaf", "ink": "bloom", "inkDim": "bloom", "inkFaint": "bloomDim", "accent": "bloomLeaf" },
    "legend": { "inkDim": "bloomLeaf", "accent": "bloomLeaf" },
    "led": { "accent": "bloomLed", "paper": "bloom", "ink": "bloomLeaf", "inkDim": "bloomDim" } } },
  "envfilter": { "svg": "assets/devices/pedal-envfilter.svg", "scale": 0.8 },
  "reverb": { "svg": "assets/devices/pedal-reverb.svg", "scale": 0.8, "plate": "assets/plates/hall.svg", "lacquer": "hall", "name": "Squatch Hall" },
  "limiter": { "svg": "assets/devices/pedal-limiter.svg", "scale": 0.8, "plate": "assets/plates/limiter.svg", "lacquer": "limiter", "name": "Squatch Limiter" },
  "splitter": { "svg": "assets/devices/splitter-{ways}.svg", "ways": [2, 3, 4], "scale": 0.8 },
  "mixer": { "svg": "assets/devices/mixer-{ways}.svg", "ways": [2, 3, 4], "scale": 0.8 },
  "nam": { "svg": "assets/devices/amp-head.svg", "scale": 0.5, "plate": "assets/plates/nam.svg", "lacquer": "amp", "name": "Squatch NAM", "params": { "gain": "input", "master": "output" } },
  "cab": { "svg": "assets/devices/cab-2x12.svg", "scale": 0.4, "plate": "assets/plates/cab.svg", "lacquer": "cab", "name": "Squatch Cab" }
 }
}
